# Example only. Never commit the populated .env file.
# Existing authenticated personal-account sessions and API identifiers are required
# for the legacy Telethon MTProto transport; MCP does not replace Telegram auth.
TG_API_ID=
TG_API_HASH=
TG_JOB_AGENT_HOME=/opt/tg-job-agent

# All outgoing actions remain disabled unless individually enabled.
# Only switch these on after old history is recovered and founder approvals verified.
TG_OUTBOUND_ENABLED=0
TG_GROUP_POSTS_ENABLED=0
TG_CHANNEL_OUTBOUND_ENABLED=0
